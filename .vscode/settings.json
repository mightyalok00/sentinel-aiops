{
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/backend",
    "${workspaceFolder}/ml_engine"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none",
    "reportMissingImports": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownVariableType": "none",
    "reportAttributeAccessIssue": "none",
    "reportArgumentType": "none",
    "reportCallIssue": "none",
    "reportOperatorIssue": "none",
    "reportOptionalMemberAccess": "none",
    "reportGeneralTypeIssues": "none"
  },
  "python.pyrefly.configPath": "${workspaceFolder}/pyrefly.toml",
  "python.pyrefly.typeCheckingMode": "off",
  "markdownlint.config": {
    "default": false
  },
  "markdown.validate.enabled": false,
  "markdown.validate.referenceLinks.enabled": "ignore",
  "markdown.validate.fragmentLinks.enabled": "ignore",
  "markdown.validate.fileLinks.enabled": "ignore"
}
